<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!-- Diagnostics belong to this private build dependency. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetGeneratorDependencies</GetTargetPathDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="AsmResolver.DotNet" Version="6.0.1" PrivateAssets="all" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.0.0.9375" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GetGeneratorDependencies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(ReferenceCopyLocalPaths->'$(TargetDir)%(Filename)%(Extension)')"
                                           IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>
