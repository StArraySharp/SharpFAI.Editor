<Project>
  <UsingTask TaskName="CollectAdofaiFilterResources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ShaderAssets ParameterType="System.String" />
      <UnityAssets ParameterType="System.String" />
      <TextureDirectory ParameterType="System.String" />
      <PreparedAssets ParameterType="System.String" />
      <Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!string.IsNullOrWhiteSpace(PreparedAssets))
        {
            var prepared = new Dictionary<string, ITaskItem>(StringComparer.Ordinal);
            var aliases = new List<string[]>();
            string root = Path.GetFullPath(PreparedAssets).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
            string manifest = Path.Combine(root, "assets.list");
            if (!File.Exists(manifest))
            {
                Log.LogError("Prepared game asset manifest is missing: {0}. Run the build/PrepareGameAssets project again.", manifest);
                return false;
            }

            foreach (string line in File.ReadLines(manifest))
            {
                string[] fields = line.Split('|');
                if (fields.Length != 3)
                {
                    Log.LogError("Invalid prepared game asset record in {0}: {1}", manifest, line);
                    return false;
                }
                if (fields[0] == "T")
                {
                    aliases.Add(fields);
                    continue;
                }

                string key = fields[1];
                string relative = fields[2];
                string path = Path.GetFullPath(Path.Combine(root, relative));
                if (fields[0] != "R" || Path.IsPathRooted(relative) ||
                    !path.StartsWith(root, StringComparison.OrdinalIgnoreCase) || !File.Exists(path) ||
                    prepared.ContainsKey(key))
                {
                    Log.LogError("Invalid or missing prepared game asset in {0}: {1}", manifest, line);
                    return false;
                }
                var item = new Microsoft.Build.Utilities.TaskItem(path);
                item.SetMetadata("LogicalName", key);
                if (relative.StartsWith("Metadata/", StringComparison.Ordinal) &&
                    (key.EndsWith(".shaderlab", StringComparison.Ordinal) || key.EndsWith(".meta", StringComparison.Ordinal)))
                    item.SetMetadata("BuildOnly", "true");
                else if (Path.GetFileNameWithoutExtension(path).EndsWith("_0", StringComparison.OrdinalIgnoreCase))
                    continue;
                else if (relative.StartsWith("Shaders/", StringComparison.Ordinal) && key.EndsWith(".glsl", StringComparison.Ordinal))
                    item.SetMetadata("CopyRelativePath", "Resources/Shaders/Filters/" + relative.Substring("Shaders/".Length));
                else if (relative.StartsWith("Textures/", StringComparison.Ordinal) && key.EndsWith(".png", StringComparison.Ordinal))
                    item.SetMetadata("CopyRelativePath", "Resources/Filters/" + relative.Substring("Textures/".Length));
                else if (relative.StartsWith("EventIcons/", StringComparison.Ordinal) &&
                    Regex.IsMatch(relative, @"\AEventIcons/[a-z0-9]+\.png\z") &&
                    key == "Resources.LevelEditor.LevelEvents." + relative.Substring("EventIcons/".Length))
                    item.SetMetadata("CopyRelativePath", "Resources/LevelEditor/LevelEvents/" + relative.Substring("EventIcons/".Length));
                else
                {
                    Log.LogError("Unsupported prepared game asset in {0}: {1}", manifest, line);
                    return false;
                }
                prepared.Add(key, item);
            }

            foreach (string[] alias in aliases)
            {
                ITaskItem original;
                if (!alias[1].StartsWith("Resources.Filters.", StringComparison.Ordinal) ||
                    !alias[1].EndsWith("_0.png", StringComparison.OrdinalIgnoreCase) ||
                    !prepared.TryGetValue(alias[2], out original) ||
                    !original.GetMetadata("CopyRelativePath").StartsWith("Resources/Filters/", StringComparison.Ordinal) ||
                    prepared.ContainsKey(alias[1]))
                {
                    Log.LogError("Invalid prepared game texture alias in {0}: {1}", manifest, alias[1]);
                    return false;
                }
                var item = new Microsoft.Build.Utilities.TaskItem(original.ItemSpec);
                item.SetMetadata("LogicalName", alias[1]);
                item.SetMetadata("BuildOnly", "true");
                item.SetMetadata("TextureAliasOf", alias[2]);
                prepared.Add(alias[1], item);
            }
            Resources = prepared.Values.ToArray();
            return true;
        }

        var imports = new SortedDictionary<string, string>(StringComparer.Ordinal);
        var shaderName = new Regex("^[ \t]*Shader\\s*\"(CameraFilterPack(?:Legacy)?/[^\"]+|ADOFAI/(?:Screen(?:Tile|Scroll)|PolarScreen)|Sprites/Tile|Hidden/(?:VideoBloom|CameraMotionBlur))\"", RegexOptions.Multiline);
        var exportNumber = new Regex(@"^([1-9]\d*)_glsl\.orig\.glsl$");
        var names = new Regex(@"^[A-Za-z0-9_ .-]+(/[A-Za-z0-9_ .-]+)+$");

        foreach (string root in new[] { ShaderAssets, UnityAssets }.Where(Directory.Exists)
            .Select(Path.GetFullPath).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var candidates = new Dictionary<string, string>(StringComparer.Ordinal);
            var shaderSources = new Dictionary<string, string>(StringComparer.Ordinal);
            var ambiguous = new HashSet<string>(StringComparer.Ordinal);
            foreach (string subfolder in new[] { "Shader", "Resources" })
            {
                string folder = Path.Combine(root, subfolder);
                if (!Directory.Exists(folder))
                    continue;

                foreach (string file in Directory.EnumerateFiles(folder, "*.shader", SearchOption.AllDirectories)
                    .OrderBy(path => path, StringComparer.Ordinal))
                {
                    var match = shaderName.Match(File.ReadAllText(file));
                    if (!match.Success)
                        continue;
                    string name = match.Groups[1].Value;
                    if (!names.IsMatch(name))
                        continue;
                    string stages = Path.Combine(Path.GetDirectoryName(file), name.Replace('/', '_'));
                    string first = name == "Sprites/Tile" ? "4_glsl.orig.glsl" : "1_glsl.orig.glsl";
                    if (!Directory.Exists(stages) || !File.Exists(Path.Combine(stages, first)))
                        continue;
                    string previous;
                    if (candidates.TryGetValue(name, out previous) &&
                        !StringComparer.OrdinalIgnoreCase.Equals(previous, stages))
                        ambiguous.Add(name);
                    else
                    {
                        candidates[name] = stages;
                        shaderSources[name] = file;
                    }
                }
            }

            foreach (var candidate in candidates)
            {
                string key = "Resources.Shaders.Filters/" + candidate.Key;
                if (imports.ContainsKey(key + ".glsl"))
                    continue;
                if (ambiguous.Contains(candidate.Key))
                {
                    Log.LogWarning("Multiple GLSL exports for filter {0} under {1}.", candidate.Key, root);
                    continue;
                }

                imports.Add(key + ".shaderlab", shaderSources[candidate.Key]);
                foreach (string path in Directory.EnumerateFiles(candidate.Value, "*_glsl.orig.glsl"))
                {
                    var match = exportNumber.Match(Path.GetFileName(path));
                    if (!match.Success)
                        continue;
                    string number = match.Groups[1].Value;
                    bool passLayout = candidate.Key.StartsWith("CameraFilterPack/BlurTiltShift", StringComparison.Ordinal)
                        || candidate.Key == "CameraFilterPack/Glow_Glow" || candidate.Key == "CameraFilterPack/Glow_Glow_Color";
                    // These five shaders' ShaderLab passes are exported as 1, 3, 4 and optionally 6.
                    string suffix = number == "1" || (candidate.Key == "Sprites/Tile" && number == "4") ? ".glsl" :
                        candidate.Key == "Hidden/VideoBloom" && number == "3" ? ".pass-1.glsl" :
                        candidate.Key == "Hidden/VideoBloom" && number == "5" ? ".pass-2.glsl" :
                        candidate.Key == "Hidden/VideoBloom" && number == "7" ? ".pass-3.glsl" :
                        candidate.Key == "Hidden/VideoBloom" && number == "8" ? ".pass-4.glsl" :
                        candidate.Key == "Hidden/CameraMotionBlur" && number == "5" ? ".pass-2.glsl" :
                        candidate.Key == "Hidden/CameraMotionBlur" && number == "7" ? ".pass-3.glsl" :
                        candidate.Key == "Hidden/CameraMotionBlur" && number == "9" ? ".pass-4.glsl" :
                        passLayout && number == "3" ? ".pass-1.glsl" :
                        passLayout && number == "4" ? ".pass-2.glsl" :
                        passLayout && number == "6" ? ".pass-3.glsl" : ".export-" + number + ".glsl";
                    imports.Add(key + suffix, path);
                }
            }
        }

        string gameResources = string.IsNullOrWhiteSpace(UnityAssets) ? null : Path.Combine(UnityAssets, "Resources");
        foreach (string folder in new[] { TextureDirectory, gameResources }.Where(Directory.Exists)
            .Select(Path.GetFullPath).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            foreach (string file in Directory.EnumerateFiles(folder, "CameraFilterPack*.png", SearchOption.AllDirectories)
                .OrderBy(path => path, StringComparer.Ordinal))
            {
                string key = "Resources.Filters." + file.Substring(folder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar).Length + 1)
                    .Replace(Path.DirectorySeparatorChar, '/');
                if (imports.ContainsKey(key))
                    continue;
                imports.Add(key, file);
                if (File.Exists(file + ".meta"))
                    imports.Add(key + ".meta", file + ".meta");
            }
        }

        if (Directory.Exists(UnityAssets))
        {
            string textures = Path.Combine(UnityAssets, "Texture2D");
            foreach (string file in new[] { "MotionBlurJitter.png", "Rotating_Petals_1.png", "Rotating_Petals_2.png", "Rotating_Petals_3.png", "tutorial_tile.png" })
            {
                string path = Path.Combine(textures, file);
                if (!File.Exists(path))
                    continue;
                string key = "Resources.Filters." + file;
                imports.Add(key, path);
                if (File.Exists(path + ".meta"))
                    imports.Add(key + ".meta", path + ".meta");
            }
        }

        const string duplicateTextureSuffix = "_0.png";
        var textureAliases = new Dictionary<string, string>(StringComparer.Ordinal);
        var resources = new List<ITaskItem>();
        foreach (var entry in imports)
        {
            var item = new Microsoft.Build.Utilities.TaskItem(entry.Value);
            item.SetMetadata("LogicalName", entry.Key);
            bool buildOnly = entry.Key.EndsWith(".shaderlab", StringComparison.Ordinal) ||
                entry.Key.EndsWith(".meta", StringComparison.Ordinal);
            if (buildOnly)
                item.SetMetadata("BuildOnly", "true");
            if (!buildOnly && (Path.GetFileNameWithoutExtension(entry.Key).EndsWith("_0", StringComparison.Ordinal) ||
                Path.GetFileNameWithoutExtension(entry.Value).EndsWith("_0", StringComparison.Ordinal)))
            {
                if (!entry.Key.StartsWith("Resources.Filters.", StringComparison.Ordinal) ||
                    !entry.Key.EndsWith(duplicateTextureSuffix, StringComparison.Ordinal))
                    continue;
                string original = entry.Key.Substring(0, entry.Key.Length - duplicateTextureSuffix.Length) + ".png";
                string originalPath;
                if (!imports.TryGetValue(original, out originalPath) || !FilesEqual(originalPath, entry.Value))
                    continue;
                string canonical;
                if (!textureAliases.TryGetValue(original, out canonical))
                {
                    if (Path.GetFileNameWithoutExtension(original).EndsWith("_0", StringComparison.Ordinal))
                        continue;
                    canonical = original;
                }
                textureAliases.Add(entry.Key, canonical);
                item.SetMetadata("TextureAliasOf", canonical);
                item.SetMetadata("BuildOnly", "true");
            }
            resources.Add(item);
        }
        Resources = resources.ToArray();

        bool FilesEqual(string original, string candidate)
        {
            using (var left = File.OpenRead(original))
            using (var right = File.OpenRead(candidate))
            {
                if (left.Length != right.Length)
                    return false;
                var leftBytes = new byte[32768];
                var rightBytes = new byte[leftBytes.Length];
                int count;
                while ((count = left.Read(leftBytes, 0, leftBytes.Length)) != 0)
                {
                    int offset = 0;
                    while (offset < count)
                    {
                        int read = right.Read(rightBytes, offset, count - offset);
                        if (read == 0)
                            return false;
                        offset += read;
                    }
                    for (int i = 0; i < count; i++)
                        if (leftBytes[i] != rightBytes[i])
                            return false;
                }
                return right.ReadByte() == -1;
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>
</Project>
