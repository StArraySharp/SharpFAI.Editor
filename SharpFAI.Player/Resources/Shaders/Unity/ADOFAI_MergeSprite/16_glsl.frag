layout(location = 0) out vec4 SV_Target0;
vec2 u_xlat0;
bool u_xlatb0;
vec4 u_xlat1;
bvec2 u_xlatb1;
vec4 u_xlat2;
vec3 u_xlat3;
vec3 u_xlat4;
vec2 u_xlat5;
bvec2 u_xlatb5;
vec2 u_xlat10;
bvec2 u_xlatb10;
float u_xlat11;
float u_xlat15;
bool u_xlatb15;
void main()
{
    u_xlat0.xy = _Texture2Pos.xy / vec2(_Texture2Scale.x, _Texture2Scale.y);
    u_xlat0.xy = u_xlat0.xy + vs_TEXCOORD0.zw;
    u_xlat10.xy = vec2(0.5, 0.5) / vec2(_Texture2Scale.x, _Texture2Scale.y);
    u_xlat0.xy = (-u_xlat10.xy) + u_xlat0.xy;
    u_xlat1.x = _Texture2Rot * -0.0174532924;
    u_xlat2.x = cos(u_xlat1.x);
    u_xlat1.x = sin(u_xlat1.x);
    u_xlat3.x = (-u_xlat1.x);
    u_xlat3.y = u_xlat2.x;
    u_xlat3.z = u_xlat1.x;
    u_xlat1.y = dot(u_xlat3.zy, u_xlat0.xy);
    u_xlat1.x = dot(u_xlat3.yx, u_xlat0.xy);
    u_xlat0.xy = u_xlat10.xy + u_xlat1.xy;
    u_xlat0.xy = u_xlat0.xy * vec2(_Texture2Scale.x, _Texture2Scale.y);
    u_xlatb10.xy = lessThan(u_xlat0.xyxy, vec4(0.0, 0.0, 0.0, 0.0)).xy;
    u_xlatb1.xy = lessThan(vec4(1.0, 1.0, 0.0, 0.0), u_xlat0.xyxx).xy;
    u_xlat2 = texture(_Texture2, u_xlat0.xy);
    u_xlatb0 = u_xlatb10.x || u_xlatb1.x;
    u_xlatb0 = u_xlatb10.y || u_xlatb0;
    u_xlatb0 = u_xlatb1.y || u_xlatb0;
    u_xlat5.xy = vec2(_Texture1Pos.x, _Texture1Pos.y) / _Texture1Scale.xy;
    u_xlat5.xy = u_xlat5.xy + vs_TEXCOORD0.xy;
    u_xlat1.xy = vec2(0.5, 0.5) / _Texture1Scale.xy;
    u_xlat5.xy = u_xlat5.xy + (-u_xlat1.xy);
    u_xlat15 = _Texture1Rot * -0.0174532924;
    u_xlat2.x = sin(u_xlat15);
    u_xlat3.x = cos(u_xlat15);
    u_xlat4.x = (-u_xlat2.x);
    u_xlat4.y = u_xlat3.x;
    u_xlat4.z = u_xlat2.x;
    u_xlat2.y = dot(u_xlat4.zy, u_xlat5.xy);
    u_xlat2.x = dot(u_xlat4.yx, u_xlat5.xy);
    u_xlat5.xy = u_xlat1.xy + u_xlat2.xy;
    u_xlat5.xy = u_xlat5.xy * _Texture1Scale.xy;
    u_xlat1 = texture(_Texture1, u_xlat5.xy);
    u_xlat15 = (-u_xlat1.w) + 1.0;
