    u_xlat15 = (u_xlatb0) ? u_xlat1.w : u_xlat15;
    u_xlatb1.xy = lessThan(u_xlat5.xyxx, vec4(0.0, 0.0, 0.0, 0.0)).xy;
    u_xlatb5.xy = lessThan(vec4(1.0, 1.0, 0.0, 0.0), u_xlat5.xyxx).xy;
    u_xlatb5.x = u_xlatb5.x || u_xlatb1.x;
    u_xlatb5.x = u_xlatb1.y || u_xlatb5.x;
    u_xlatb5.x = u_xlatb5.y || u_xlatb5.x;
    u_xlatb10.x = 0.0<_DisableTexture1;
    u_xlatb5.x = u_xlatb5.x || u_xlatb10.x;
    u_xlat10.x = (u_xlatb5.x) ? u_xlat2.w : u_xlat15;
    u_xlatb0 = u_xlatb0 && u_xlatb5.x;
    u_xlat0.x = (u_xlatb0) ? 0.0 : u_xlat10.x;
    u_xlat5.x = (-u_xlat0.x) + 1.0;
    u_xlat10.xy = vec2(_Texture3Pos.x, _Texture3Pos.y) / _Texture3Scale.xy;
    u_xlat10.xy = u_xlat10.xy + vs_TEXCOORD1.xy;
    u_xlat1.xy = vec2(0.5, 0.5) / _Texture3Scale.xy;
    u_xlat10.xy = u_xlat10.xy + (-u_xlat1.xy);
    u_xlat11 = _Texture3Rot * -0.0174532924;
    u_xlat2.x = sin(u_xlat11);
    u_xlat3.x = cos(u_xlat11);
    u_xlat4.x = (-u_xlat2.x);
    u_xlat4.y = u_xlat3.x;
    u_xlat4.z = u_xlat2.x;
    u_xlat2.y = dot(u_xlat4.zy, u_xlat10.xy);
    u_xlat2.x = dot(u_xlat4.yx, u_xlat10.xy);
    u_xlat10.xy = u_xlat1.xy + u_xlat2.xy;
    u_xlat10.xy = u_xlat10.xy * _Texture3Scale.xy;
    u_xlat1 = texture(_Texture3, u_xlat10.xy);
    u_xlat5.x = u_xlat1.w * u_xlat5.x + u_xlat0.x;
    u_xlatb1.xy = lessThan(u_xlat10.xyxx, vec4(0.0, 0.0, 0.0, 0.0)).xy;
    u_xlatb10.xy = lessThan(vec4(1.0, 1.0, 1.0, 1.0), u_xlat10.xyxy).xy;
    u_xlatb10.x = u_xlatb10.x || u_xlatb1.x;
    u_xlatb10.x = u_xlatb1.y || u_xlatb10.x;
    u_xlatb10.x = u_xlatb10.y || u_xlatb10.x;
    u_xlatb15 = 0.0<_DisableTexture3;
    u_xlatb10.x = u_xlatb10.x || u_xlatb15;
    u_xlat0.x = (u_xlatb10.x) ? u_xlat0.x : u_xlat5.x;
    u_xlat5.x = (-u_xlat0.x) + 1.0;
    u_xlat10.xy = _Texture4Pos.xy / vec2(_Texture4Scale.x, _Texture4Scale.y);
    u_xlat10.xy = u_xlat10.xy + vs_TEXCOORD1.zw;
    u_xlat1.xy = vec2(0.5, 0.5) / vec2(_Texture4Scale.x, _Texture4Scale.y);
    u_xlat10.xy = u_xlat10.xy + (-u_xlat1.xy);
    u_xlat11 = _Texture4Rot * -0.0174532924;
    u_xlat2.x = sin(u_xlat11);
    u_xlat3.x = cos(u_xlat11);
    u_xlat4.x = (-u_xlat2.x);
    u_xlat4.y = u_xlat3.x;
    u_xlat4.z = u_xlat2.x;
    u_xlat2.y = dot(u_xlat4.zy, u_xlat10.xy);
    u_xlat2.x = dot(u_xlat4.yx, u_xlat10.xy);
    u_xlat10.xy = u_xlat1.xy + u_xlat2.xy;
    u_xlat10.xy = u_xlat10.xy * vec2(_Texture4Scale.x, _Texture4Scale.y);
    u_xlat1 = texture(_Texture4, u_xlat10.xy);
